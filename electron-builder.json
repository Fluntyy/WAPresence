{
  "appId": "com.wapresence.app",
  "productName": "WAPresence",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/smtc-helper.ps1"
  ],
  "publish": {
    "provider": "github",
    "owner": "Fluntyy",
    "repo": "WAPresence",
    "private": true
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "maintainer": "WAPresence <wapresence@users.noreply.github.com>",
    "icon": "assets/icon.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.utilities",
    "icon": "assets/icon.png",
    "identity": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
